# 이 파일을 복사해서 .env 를 만들고 실제 값을 채워주세요. (.env는 git에 커밋하지 마세요)

# 백엔드 API 서버 주소 (끝에 슬래시 없이)
REACT_APP_API_BASE_URL=

# 카카오맵 JavaScript 키 (https://developers.kakao.com 에서 발급)
REACT_APP_KAKAO_MAP_KEY=

# [MVP 임시용] 관리자(/admin) 로그인 비밀번호.
# 백엔드의 POST /api/admin/login이 아직 없을 때, 이 값을 채워두면 프론트에서 직접 비교해 로그인합니다.
# 백엔드 로그인 API가 완성되면 이 줄을 지우세요(그러면 자동으로 서버 로그인으로 전환됩니다).
REACT_APP_ADMIN_PASSWORD=1q2w3e4r!!
